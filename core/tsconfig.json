{
  // Editor-only config: no app extends or builds from this file.
  // Each app type-checks core/ with its own tsconfig (mobile/tsconfig.json, web/tsconfig.app.json).
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["jest"],
    "typeRoots": ["../mobile/node_modules/@types"],
    // core/ has no node_modules; the editor borrows mobile's copies.
    "paths": {
      "zod": ["../mobile/node_modules/zod"],
      "@reduxjs/toolkit": ["../mobile/node_modules/@reduxjs/toolkit"],
      "@reduxjs/toolkit/*": ["../mobile/node_modules/@reduxjs/toolkit/*"],
      "react-redux": ["../mobile/node_modules/react-redux"],
      "react": ["../mobile/node_modules/@types/react"],
      "react-hook-form": ["../mobile/node_modules/react-hook-form"],
      "@hookform/resolvers/*": ["../mobile/node_modules/@hookform/resolvers/*"]
    }
  },
  "include": ["**/*.ts"]
}
