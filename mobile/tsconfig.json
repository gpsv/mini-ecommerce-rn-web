{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // core/ has no node_modules: map @core and the packages it imports to this app.
    "paths": {
      "@core/*": ["../core/*"],
      "zod": ["./node_modules/zod"],
      "@reduxjs/toolkit": ["./node_modules/@reduxjs/toolkit"],
      "@reduxjs/toolkit/*": ["./node_modules/@reduxjs/toolkit/*"],
      "react-redux": ["./node_modules/react-redux"],
      "react": ["./node_modules/@types/react"],
      "react-hook-form": ["./node_modules/react-hook-form"],
      "@hookform/resolvers/*": ["./node_modules/@hookform/resolvers/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../core/**/*.ts"],
  "exclude": ["**/node_modules", "**/Pods"]
}
