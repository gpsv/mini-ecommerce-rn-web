{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* core/ resolution: core/ has no node_modules, so its imports map to this app */
    "paths": {
      "@core/*": ["../core/*"],
      "zod": ["./node_modules/zod"],
      "@reduxjs/toolkit": ["./node_modules/@reduxjs/toolkit"],
      "@reduxjs/toolkit/*": ["./node_modules/@reduxjs/toolkit/*"],
      "react-redux": ["./node_modules/react-redux"],
      "react": ["./node_modules/@types/react"],
      "react-hook-form": ["./node_modules/react-hook-form"],
      "@hookform/resolvers/*": ["./node_modules/@hookform/resolvers/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../core"],
  "exclude": ["../core/**/__tests__"]
}
